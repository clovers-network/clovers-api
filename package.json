{
  "name": "clovers-api",
  "version": "0.0.1",
  "description": "Clovers API",
  "main": "dist",
  "scripts": {
    "db": "rethinkdb",
    "dev": "DEBUG=app:* nodemon -w src --exec \"babel-node src --presets es2015,stage-0\"",
    "build": "babel src -s -D -d dist --presets es2015,stage-0",
    "start": "pm2 start ecosystem.config.js --env production",
    "prestart": "npm run -s build",
    "start-dev": "pm2 start ecosystem.config.js",
    "prestart-dev": "npm run -s prestart",
    "reload": "pm2 reload ecosystem.config.js --env production",
    "prereload": "npm i && npm run -s build",
    "test": "npm run lint && npm run -s build && npm run -s test:unit",
    "contracts": "npm i clovers-network/clovers-contracts --force",
    "accessremote": "ssh -fNTL localhost:8080:127.0.0.1:8080  clover",
    "accessremote-main": "ssh -fNTL localhost:8080:127.0.0.1:8080  clover-main",
    "killremote": "kill $(ps aux | grep '[s]sh' | grep 8080 | awk '{print $2}')",
    "lint": "eslint src",
    "test:unit": "node --test \"test/*.test.js\""
  },
  "eslintConfig": {
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "env": {
      "node": true,
      "es2022": true
    },
    "rules": {
      "no-console": 0,
      "no-unused-vars": 1,
      "no-empty": [
        "error",
        {
          "allowEmptyCatch": true
        }
      ]
    },
    "globals": {
      "WebSocket": "readonly"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clovers-network/clovers-api.git"
  },
  "author": "Billy Rennekamp <billy.rennekamp@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.4"
  },
  "dependencies": {
    "babel-runtime": "6.26.0",
    "bignumber.js": "7.2.1",
    "body-parser": "1.18.3",
    "clovers-contracts": "2.2.0",
    "clovers-reversi": "1.0.21",
    "compression": "1.7.3",
    "cors": "2.8.4",
    "debug": "4.1.0",
    "escape-string-regexp": "2.0.0",
    "eth-sig-util": "1.4.2",
    "ethers": "4.0.33",
    "express": "4.16.3",
    "express-basic-auth": "1.1.5",
    "fecha": "2.3.3",
    "fs-extra": "6.0.1",
    "morgan": "1.9.0",
    "pm2": "3.0.3",
    "resource-router-middleware": "0.6.0",
    "rethinkdb": "2.3.3",
    "socket.io": "^4.8.1",
    "uuid": "3.3.2",
    "web3-utils": "1.0.0-beta.35",
    "ws": "5.2.2",
    "xss": "1.0.3"
  },
  "devDependencies": {
    "babel-cli": "6.26.0",
    "babel-core": "6.26.3",
    "babel-plugin-transform-runtime": "6.23.0",
    "babel-preset-es2015": "6.24.1",
    "babel-preset-stage-0": "6.24.1",
    "eslint": "^8.57.0",
    "nodemon": "1.18.3",
    "socket.io-client": "^4.8.1"
  },
  "bugs": {
    "url": "https://github.com/clovers-network/clovers-api/issues"
  },
  "homepage": "https://github.com/clovers-network/clovers-api#readme",
  "keywords": [
    "clovers.network",
    "ethereum",
    "web3",
    "js"
  ]
}
